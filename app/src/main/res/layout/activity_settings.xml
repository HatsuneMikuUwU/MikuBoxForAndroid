<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceVariant"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorBg"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            style="?attr/collapsingToolbarLayoutLargeStyle"
            android:layout_height="?attr/collapsingToolbarLayoutLargeSize"
            android:background="?attr/colorBg"
            app:collapsedTitleTextColor="?attr/colorOnSurfaceVariant"
            app:contentScrim="?attr/colorBg"
            app:expandedTitleMarginEnd="24dp"
            app:expandedTitleMarginStart="24dp"
            app:expandedTitleTextColor="?attr/colorOnSurfaceVariant"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:title="@string/settings"
            app:titleCollapseMode="scale">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:alpha="0.7"
                android:contentDescription="@null"
                android:src="@drawable/uwu_banner_image_2"
                android:visibility="gone"
                app:layout_collapseMode="parallax" />

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="?attr/colorOnSurfaceVariant"
                app:titleTextColor="?attr/colorOnSurfaceVariant" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/uwu_background_collapse"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="16dp"
            android:paddingTop="16dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/settings_section_appearance" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/row_theme"
                        style="@style/SettingsRow">

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_theme" />

                            <TextView
                                android:id="@+id/tv_theme_value"
                                style="@style/SettingsRowSummary"
                                tools:ignore="MissingClass" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/row_particles"
                        style="@style/SettingsRow">

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_particles" />

                            <TextView
                                style="@style/SettingsRowSummary"
                                android:text="@string/settings_particles_summary" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_particles"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:clickable="false"
                            android:focusable="false" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/settings_section_connection" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/row_boot"
                        style="@style/SettingsRow">

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_boot" />

                            <TextView
                                style="@style/SettingsRowSummary"
                                android:text="@string/settings_boot_summary" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_boot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:clickable="false"
                            android:focusable="false" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/row_mtu"
                        style="@style/SettingsRow">

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_mtu" />

                            <TextView
                                android:id="@+id/tv_mtu_value"
                                style="@style/SettingsRowSummary" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/row_apps"
                        style="@style/SettingsRow">

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_per_app" />

                            <TextView
                                android:id="@+id/tv_apps_value"
                                style="@style/SettingsRowSummary" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/settings_section_backup" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/row_export"
                        style="@style/SettingsRow">

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_export" />

                            <TextView
                                style="@style/SettingsRowSummary"
                                android:text="@string/settings_export_summary" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/row_import"
                        style="@style/SettingsRow">

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_import" />

                            <TextView
                                style="@style/SettingsRowSummary"
                                android:text="@string/settings_import_summary" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
