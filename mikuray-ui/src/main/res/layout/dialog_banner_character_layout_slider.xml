<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="8dp"
    android:paddingTop="12dp"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_label_banner_width"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.slider.Slider
            android:id="@+id/slider_banner_width"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelBehavior="floating"
            app:tickVisibilityMode="hidden" />

        <TextView
            android:id="@+id/text_label_banner_height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="8dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.slider.Slider
            android:id="@+id/slider_banner_height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelBehavior="floating"
            app:tickVisibilityMode="hidden" />

        <TextView
            android:id="@+id/text_label_banner_margin_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="8dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.slider.Slider
            android:id="@+id/slider_banner_margin_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelBehavior="floating"
            app:tickVisibilityMode="hidden" />

        <TextView
            android:id="@+id/text_label_banner_margin_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="8dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.slider.Slider
            android:id="@+id/slider_banner_margin_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelBehavior="floating"
            app:tickVisibilityMode="hidden" />

        <TextView
            android:id="@+id/text_label_banner_margin_end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="8dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.slider.Slider
            android:id="@+id/slider_banner_margin_end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelBehavior="floating"
            app:tickVisibilityMode="hidden" />

    </LinearLayout>

</ScrollView>
