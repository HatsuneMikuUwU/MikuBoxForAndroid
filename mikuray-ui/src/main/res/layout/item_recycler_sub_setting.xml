<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="4dp"
    android:gravity="center_vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="?attr/colorCard"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <LinearLayout
                android:id="@+id/header_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="17sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/chk_enable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbIcon="@drawable/mtrl_ic_check" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_url"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/header_layout" />

            <com.google.android.material.chip.Chip
                android:id="@+id/tv_server_count"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginTop="12dp"
                android:checkable="false"
                android:clickable="false"
                android:focusable="false"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:textSize="12sp"
                app:chipBackgroundColor="?attr/colorSecondaryContainer"
                app:chipMinTouchTargetSize="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_url" />

            <com.google.android.material.chip.Chip
                android:id="@+id/tv_subscription_usage"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:checkable="false"
                android:clickable="false"
                android:ellipsize="end"
                android:focusable="false"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnTertiaryContainer"
                android:textSize="12sp"
                app:chipBackgroundColor="?attr/colorTertiaryContainer"
                app:chipMinTouchTargetSize="0dp"
                app:layout_constraintStart_toEndOf="@id/tv_server_count"
                app:layout_constraintTop_toTopOf="@id/tv_server_count" />

            <com.google.android.material.chip.Chip
                android:id="@+id/tv_subscription_expire"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginTop="8dp"
                android:checkable="false"
                android:clickable="false"
                android:ellipsize="end"
                android:focusable="false"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="12sp"
                app:chipBackgroundColor="?attr/colorPrimaryContainer"
                app:chipMinTouchTargetSize="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_server_count" />

            <TextView
                android:id="@+id/tv_last_updated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintBottom_toBottomOf="@id/layout_share"
                app:layout_constraintEnd_toStartOf="@id/layout_share"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/layout_share" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/layout_remove"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/menu_item_del_config"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_subscription_expire"
                app:srcCompat="@drawable/ic_delete_empty"
                app:tint="?attr/colorError" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/layout_edit"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/menu_item_edit_config"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="@id/layout_remove"
                app:layout_constraintEnd_toStartOf="@id/layout_remove"
                app:layout_constraintTop_toTopOf="@id/layout_remove"
                app:srcCompat="@drawable/ic_edit_color"
                app:tint="@null" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/layout_share"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/title_configuration_share"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="@id/layout_remove"
                app:layout_constraintEnd_toStartOf="@id/layout_edit"
                app:layout_constraintTop_toTopOf="@id/layout_remove"
                app:srcCompat="@drawable/ic_share_color"
                app:tint="@null" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
