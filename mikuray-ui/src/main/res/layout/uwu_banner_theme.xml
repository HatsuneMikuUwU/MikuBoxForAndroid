<?xml version="1.0" encoding="utf-8"?>
<com.miku.ray.widget.ClipRoundedCardView
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginTop="4dp"
    android:orientation="vertical"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <com.miku.ray.widget.ClipRoundedCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:layout_marginTop="0dp"
            android:clickable="false"
            android:clipToPadding="false"
            app:cardBackgroundColor="?attr/colorCard"
            app:cardCornerRadius="5dp"
            app:cardElevation="0dp"
            app:rippleColor="@android:color/transparent"
            app:strokeWidth="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:padding="16dp">
                <com.miku.ray.widget.ClipRoundedCardView
                    android:id="@+id/theme_banner_image_card"
                    android:layout_width="140dp"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#00000000"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:rippleColor="?android:attr/colorControlHighlight"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:id="@+id/img_banner_preference"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/uwu_banner_theme" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.2"
                        android:background="@android:color/black" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical">
                        <TextClock
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="-12dp"
                            android:fontFeatureSettings="tnum, cv03, cv04"
                            android:format12Hour="hh"
                            android:format24Hour="kk"
                            android:gravity="center"
                            android:textColor="@android:color/white"
                            android:textSize="56sp" />
                        <TextClock
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-12dp"
                            android:fontFeatureSettings="tnum, cv03, cv04"
                            android:format12Hour="mm"
                            android:format24Hour="mm"
                            android:gravity="center"
                            android:textColor="@android:color/white"
                            android:textSize="56sp" />
                    </LinearLayout>
                </com.miku.ray.widget.ClipRoundedCardView>
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/uwu_name_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="@string/uwu_name_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="17sp" />
                    <TextView
                        android:id="@+id/uwu_name_title_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignStart="@+id/uwu_name_title"
                        android:layout_below="@+id/uwu_name_title"
                        android:layout_marginBottom="12dp"
                        android:clickable="true"
                        android:ellipsize="marquee"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:text="@string/app_name"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/uwu_mikubox_author"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignStart="@+id/uwu_name_title_summary"
                        android:layout_below="@+id/uwu_name_title_summary"
                        android:singleLine="true"
                        android:text="@string/uwu_mikubox_author_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="17sp" />
                    <TextView
                        android:id="@+id/uwu_mikubox_author_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignStart="@+id/uwu_mikubox_author"
                        android:layout_below="@+id/uwu_mikubox_author"
                        android:layout_marginBottom="12dp"
                        android:clickable="true"
                        android:ellipsize="marquee"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:text="HatsuneMikuUwU"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/uwu_build_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignStart="@+id/uwu_mikubox_author_summary"
                        android:layout_below="@+id/uwu_mikubox_author_summary"
                        android:singleLine="true"
                        android:text="@string/uwu_build_date_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="17sp" />
                    <TextView
                        android:id="@+id/uwu_build_date_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignStart="@+id/uwu_build_date"
                        android:layout_below="@+id/uwu_build_date"
                        android:layout_marginBottom="12dp"
                        android:clickable="true"
                        android:ellipsize="marquee"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/uwu_version_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignStart="@+id/uwu_build_date_summary"
                        android:layout_below="@+id/uwu_build_date_summary"
                        android:singleLine="true"
                        android:text="@string/uwu_version_name_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="17sp" />
                    <TextView
                        android:id="@+id/uwu_version_name_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignStart="@+id/uwu_version_name"
                        android:layout_below="@+id/uwu_version_name"
                        android:layout_marginBottom="12dp"
                        android:clickable="true"
                        android:ellipsize="marquee"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/uwu_version_code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignStart="@+id/uwu_version_name_summary"
                        android:layout_below="@+id/uwu_version_name_summary"
                        android:singleLine="true"
                        android:text="@string/uwu_version_code_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="17sp" />
                    <TextView
                        android:id="@+id/uwu_version_code_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignStart="@+id/uwu_version_code"
                        android:layout_below="@+id/uwu_version_code"
                        android:layout_marginBottom="12dp"
                        android:clickable="true"
                        android:ellipsize="marquee"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/uwu_package_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignStart="@+id/uwu_version_code_summary"
                        android:layout_below="@+id/uwu_version_code_summary"
                        android:singleLine="true"
                        android:text="@string/uwu_package_name_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="17sp" />
                    <TextView
                        android:id="@+id/uwu_package_name_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignStart="@+id/uwu_package_name"
                        android:layout_below="@+id/uwu_package_name"
                        android:clickable="true"
                        android:ellipsize="marquee"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp" />
                </RelativeLayout>
            </LinearLayout>
        </com.miku.ray.widget.ClipRoundedCardView>
        <com.miku.ray.widget.ClipRoundedCardView
            android:id="@+id/onClick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:layout_marginTop="4dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorCard"
            app:cardCornerRadius="5dp"
            app:cardElevation="0dp"
            app:rippleColor="?android:attr/colorControlHighlight"
            app:strokeWidth="0dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:layout_marginEnd="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="16dp"
                        android:gravity="center">
                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp">
                            <com.miku.ray.widget.DynamicShapeImageView
                                android:layout_width="45dp"
                                android:layout_height="45dp"
                                android:scaleType="centerCrop"
                                app:shapeBackgroundColor="?attr/colorPrimary"
                                app:shapeTarget="icon" />
                            <androidx.preference.internal.PreferenceImageView
                                android:id="@android:id/icon"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:layout_gravity="center"
                                android:tint="?attr/colorOnPrimary" />
                        </FrameLayout>
                    </LinearLayout>
                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1.0"
                        android:paddingBottom="16dp"
                        android:paddingTop="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:id="@android:id/title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="marquee"
                                android:singleLine="false"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textSize="17sp">
                                <aapt:attr name="android:textColor">
                                    <selector>
                                        <item android:alpha="0.38" android:color="?attr/colorOnSurface" android:state_enabled="false" />
                                        <item android:color="?attr/colorOnSurface" />
                                    </selector>
                                </aapt:attr>
                            </TextView>
                            <TextView
                                android:id="@android:id/summary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignStart="@android:id/title"
                                android:layout_below="@android:id/title"
                                android:ellipsize="marquee"
                                android:marqueeRepeatLimit="marquee_forever"
                                android:singleLine="false"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textSize="14sp">
                                <aapt:attr name="android:textColor">
                                    <selector>
                                        <item android:alpha="0.38" android:color="?attr/colorOnSurfaceVariant" android:state_enabled="false" />
                                        <item android:color="?attr/colorOnSurfaceVariant" />
                                    </selector>
                                </aapt:attr>
                            </TextView>
                        </LinearLayout>
                    </RelativeLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginStart="0dp"
                        android:layout_marginTop="16dp"
                        android:gravity="center">
                        <FrameLayout
                            android:layout_width="28dp"
                            android:layout_height="28dp">

                            <com.miku.ray.widget.DynamicShapeImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:scaleType="centerCrop"
                                app:shapeBackgroundColor="?attr/colorSurfaceContainerHighest"
                                app:shapeTarget="arrow" />

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/rmx_arrows_arrow_right_double_line"
                                android:tint="?attr/colorOnSurfaceVariant" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.miku.ray.widget.ClipRoundedCardView>
    </LinearLayout>
</com.miku.ray.widget.ClipRoundedCardView>
