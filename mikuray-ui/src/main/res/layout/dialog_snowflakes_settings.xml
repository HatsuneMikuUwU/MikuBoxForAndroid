<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="12dp">

        <TextView
            android:id="@+id/text_snowflakes_speed_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?android:attr/textColorPrimary" />
        <com.google.android.material.slider.Slider
            android:id="@+id/slider_snowflakes_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.25"
            android:valueFrom="0.25"
            android:valueTo="3.0"
            app:labelBehavior="floating"
            app:tickVisibilityMode="hidden" />

        <TextView
            android:id="@+id/text_snowflakes_count_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?android:attr/textColorPrimary" />
        <com.google.android.material.slider.Slider
            android:id="@+id/slider_snowflakes_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:valueFrom="10"
            android:valueTo="120"
            app:labelBehavior="floating"
            app:tickVisibilityMode="hidden" />

        <TextView
            android:id="@+id/text_snowflakes_size_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?android:attr/textColorPrimary" />
        <com.google.android.material.slider.Slider
            android:id="@+id/slider_snowflakes_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.1"
            android:valueFrom="0.5"
            android:valueTo="2.0"
            app:labelBehavior="floating"
            app:tickVisibilityMode="hidden" />

        <TextView
            android:id="@+id/text_snowflakes_opacity_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?android:attr/textColorPrimary" />
        <com.google.android.material.slider.Slider
            android:id="@+id/slider_snowflakes_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.05"
            android:valueFrom="0.10"
            android:valueTo="1.0"
            app:labelBehavior="floating"
            app:tickVisibilityMode="hidden" />

        <TextView
            android:id="@+id/text_snowflakes_life_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?android:attr/textColorPrimary" />
        <com.google.android.material.slider.Slider
            android:id="@+id/slider_snowflakes_life"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.5"
            android:valueFrom="1.0"
            android:valueTo="30.0"
            app:labelBehavior="floating"
            app:tickVisibilityMode="hidden" />

        <TextView
            android:id="@+id/text_snowflakes_wind_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?android:attr/textColorPrimary" />
        <com.google.android.material.slider.Slider
            android:id="@+id/slider_snowflakes_wind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.25"
            android:valueFrom="0.0"
            android:valueTo="3.0"
            app:labelBehavior="floating"
            app:tickVisibilityMode="hidden" />
    </LinearLayout>
</ScrollView>
