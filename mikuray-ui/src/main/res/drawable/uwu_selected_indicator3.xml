<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:shape="rectangle">
            <solid
                android:color="?attr/colorPrimary" />
            <corners
                android:radius="16dp" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:top="-1dp">
        <inset>
            <shape
                android:shape="rectangle">
                <solid
                    android:color="?attr/colorCard" />
                <corners
                    android:radius="16dp" />
            </shape>
        </inset>
    </item>
</layer-list>
